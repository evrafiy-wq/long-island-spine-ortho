{
  // Terminal → Run Task… (or ⇧⌘B for the default build task).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "Start the Next.js dev server on http://localhost:3000"
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      // Stop `dev` first — a build replaces .next/ underneath a running dev
      // server and it starts 500ing.
      "detail": "Production build. Stop the dev task first."
    },
    {
      "label": "lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"],
      "detail": "ESLint"
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"],
      "detail": "tsc --noEmit"
    },
    {
      "label": "contrast audit",
      "type": "shell",
      "command": "node scripts/audit-contrast.mjs",
      "problemMatcher": [],
      "detail": "WCAG contrast gate — run after any colour change"
    }
  ]
}
