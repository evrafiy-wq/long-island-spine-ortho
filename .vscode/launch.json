{
  // Run the site from VS Code: press F5, or Run and Debug (⇧⌘D) → pick a config.
  //
  // The site is a Next.js app. It does NOT run by opening an .html file — there
  // are none. It has to be served by the dev server, which these configs start.
  "version": "0.2.0",
  "configurations": [
    {
      // START HERE. Starts `npm run dev` and opens the browser on it once the
      // server reports ready. Breakpoints work in both Server and Client
      // Components.
      "name": "Next.js: dev server + browser",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      // Just the server, in VS Code's integrated terminal. Open
      // http://localhost:3000 yourself.
      "name": "Next.js: dev server only",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      // Attach a browser to a dev server you already started in a terminal.
      "name": "Next.js: browser only (server already running)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
