:root {
  /* Core Colors */
  --ink: #173b4c;
  --ink-deep: #0d2c3b;
  --ink-soft: #536a74;
  --teal: #087970;
  --teal-dark: #05635c;
  --teal-pale: #e3f0ed;
  --cream: #fbfaf7;
  --warm-white: #fffefd;
  --mist: #f0f5f3;
  --line: #d6e1de;
  --gold: #bd914a;
  --gold-pale: #f4ead9;
  --white: #ffffff;
  
  /* Shadows - More refined */
  --shadow-xs: 0 2px 8px rgba(13, 44, 59, 0.04);
  --shadow-sm: 0 8px 16px rgba(13, 44, 59, 0.08);
  --shadow-md: 0 16px 32px rgba(13, 44, 59, 0.12);
  --shadow-lg: 0 24px 48px rgba(13, 44, 59, 0.16);
  
  /* Spacing */
  --spacing-xs: 0.5rem;
  --spacing-sm: 1rem;
  --spacing-md: 1.5rem;
  --spacing-lg: 2rem;
  --spacing-xl: 3rem;
  --spacing-2xl: 4rem;
  --spacing-3xl: 6rem;
  
  /* Border Radius */
  --radius-sm: 8px;
  --radius: 12px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;
  
  /* Typography */
  --font-sans: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-serif: "DM Serif Display", serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 6.5rem;
}

body {
  margin: 0;
  overflow-x: hidden;
  color: var(--ink);
  background: var(--cream);
  font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 16px;
  line-height: 1.65;
}

body.nav-open {
  overflow: hidden;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
}

button,
input,
textarea,
select {
  font: inherit;
}

:focus-visible {
  outline: 3px solid #d6a752;
  outline-offset: 4px;
}

.container {
  width: min(1180px, calc(100% - 3rem));
  margin-inline: auto;
}

.skip-link {
  position: fixed;
  top: 0.8rem;
  left: 0.8rem;
  z-index: 100;
  padding: 0.65rem 1rem;
  color: var(--ink-deep);
  background: var(--white);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-lg);
  font-weight: 700;
  text-decoration: none;
  transform: translateY(-160%);
  transition: transform 0.2s ease;
}

.skip-link:focus {
  transform: translateY(0);
}

.utility-bar {
  color: #dceae8;
  background: var(--ink-deep);
  font-size: 0.78rem;
  font-weight: 600;
}

.utility-content,
.utility-links {
  display: flex;
  align-items: center;
}

.utility-content {
  justify-content: space-between;
  gap: 1rem;
  min-height: 2.35rem;
}

.utility-content p {
  margin: 0;
}

.utility-links {
  gap: 0.6rem;
}

.utility-links a {
  color: inherit;
  text-decoration: none;
}

.utility-links a:hover {
  color: var(--white);
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  border-bottom: 1px solid rgba(214, 225, 222, 0.9);
  background: rgba(255, 254, 253, 0.94);
  backdrop-filter: blur(14px);
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  min-height: 5.3rem;
}

.brand {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.72rem;
  color: var(--ink-deep);
  text-decoration: none;
}

.brand-mark {
  width: 43px;
  height: 43px;
}

.brand-name {
  display: grid;
  gap: 0.02rem;
  font-size: 0.76rem;
  font-weight: 500;
  letter-spacing: 0.015em;
  line-height: 1.18;
}

.brand-name strong {
  font-size: 0.92rem;
  font-weight: 700;
  letter-spacing: -0.015em;
}

.site-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: clamp(0.85rem, 1.5vw, 1.45rem);
}

.site-nav > a:not(.nav-cta) {
  color: var(--ink-soft);
  font-size: 0.86rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}

.site-nav > a:not(.nav-cta):hover {
  color: var(--teal-dark);
}

.nav-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.74rem 0.92rem;
  color: var(--white);
  background: var(--teal);
  border: 1px solid var(--teal);
  border-radius: 8px;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.nav-cta:hover {
  background: var(--teal-dark);
  border-color: var(--teal-dark);
  transform: translateY(-1px);
}

.nav-cta svg {
  width: 15px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.7;
}

.nav-toggle {
  display: none;
  align-items: center;
  gap: 0.55rem;
  padding: 0.45rem 0;
  color: var(--ink-deep);
  background: transparent;
  border: 0;
  cursor: pointer;
  font-size: 0.82rem;
  font-weight: 700;
}

.nav-toggle-icon {
  display: grid;
  gap: 4px;
  width: 20px;
}

.nav-toggle-icon i {
  display: block;
  width: 20px;
  height: 2px;
  background: currentColor;
  border-radius: 4px;
  transition: transform 0.2s ease;
}

.nav-toggle[aria-expanded="true"] .nav-toggle-icon i:first-child {
  transform: translateY(3px) rotate(45deg);
}

.nav-toggle[aria-expanded="true"] .nav-toggle-icon i:last-child {
  transform: translateY(-3px) rotate(-45deg);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: clamp(4.5rem, 7vw, 7.4rem) 0 clamp(4.7rem, 7vw, 7rem);
  background:
    linear-gradient(112deg, #fffefd 0%, #fbfcf9 51%, #eaf3f0 100%);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-orb-one {
  top: -15rem;
  left: -14rem;
  width: 34rem;
  height: 34rem;
  border: 1px solid rgba(8, 121, 112, 0.1);
}

.hero-orb-two {
  right: -9rem;
  bottom: -13rem;
  width: 31rem;
  height: 31rem;
  background: rgba(189, 145, 74, 0.09);
}

.hero-layout {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.06fr) minmax(360px, 0.94fr);
  align-items: center;
  gap: clamp(2rem, 6vw, 6.5rem);
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin: 0 0 1.05rem;
  color: var(--teal-dark);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  line-height: 1.2;
  text-transform: uppercase;
}

.eyebrow::before {
  width: 28px;
  height: 2px;
  background: currentColor;
  content: "";
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2 {
  color: var(--ink-deep);
  font-family: "DM Serif Display", Georgia, serif;
  font-weight: 400;
  letter-spacing: -0.04em;
  line-height: 1.05;
  text-wrap: balance;
}

h1 {
  max-width: 700px;
  margin-bottom: 1.35rem;
  font-size: clamp(3.4rem, 5.6vw, 5.7rem);
}

h1 em {
  color: var(--teal);
}

h2 {
  margin-bottom: 1.15rem;
  font-size: clamp(2.35rem, 4vw, 4.05rem);
}

h3 {
  color: var(--ink-deep);
  font-size: 1.15rem;
  line-height: 1.3;
}

.hero-intro,
.section-intro > p,
.steps-heading > p,
.physician-copy > p,
.team-intro > p,
.visit-copy > p,
.appointment-card > div > p,
.footer-brand > p,
.team-member > div > p:not(.member-role) {
  color: var(--ink-soft);
}

.hero-intro {
  max-width: 620px;
  margin-bottom: 0;
  font-size: clamp(1.03rem, 1.5vw, 1.16rem);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.35rem;
  margin-top: 2rem;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 3.25rem;
  padding: 0.85rem 1.25rem;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 0.92rem;
  font-weight: 700;
  text-align: center;
  text-decoration: none;
  transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  color: var(--white);
  background: var(--teal);
  box-shadow: 0 13px 28px rgba(8, 121, 112, 0.2);
}

.button-primary:hover {
  background: var(--teal-dark);
  box-shadow: 0 16px 30px rgba(8, 121, 112, 0.25);
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--ink-deep);
  font-size: 0.91rem;
  font-weight: 700;
  text-decoration: none;
}

.text-link span {
  color: var(--teal);
  font-size: 1.1rem;
  transition: transform 0.2s ease;
}

.text-link:hover span {
  transform: translateX(3px);
}

.hero-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem 1.35rem;
  margin: 2.2rem 0 0;
  padding: 0;
  color: var(--ink-soft);
  font-size: 0.82rem;
  font-weight: 600;
  list-style: none;
}

.hero-highlights li {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.hero-highlights svg {
  width: 18px;
  fill: none;
  stroke: var(--teal);
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.75;
}

.hero-portrait-wrap {
  position: relative;
  z-index: 1;
  justify-self: end;
  width: min(100%, 470px);
  padding: 0.9rem;
  background: rgba(255, 255, 255, 0.66);
  border: 1px solid rgba(214, 225, 222, 0.9);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.hero-portrait-frame {
  position: relative;
  height: clamp(450px, 49vw, 575px);
  overflow: hidden;
  background: #d8d6d0;
  border-radius: calc(var(--radius-lg) - 7px);
}

.hero-portrait-frame::after {
  position: absolute;
  inset: auto 0 0;
  height: 28%;
  background: linear-gradient(transparent, rgba(13, 44, 59, 0.2));
  content: "";
}

.hero-portrait-frame img,
.physician-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.portrait-caption {
  position: absolute;
  bottom: 1.9rem;
  left: -2.7rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  max-width: 275px;
  padding: 0.78rem 1rem 0.78rem 0.78rem;
  color: var(--ink-deep);
  background: var(--warm-white);
  border-radius: 10px;
  box-shadow: 0 14px 32px rgba(13, 44, 59, 0.16);
}

.portrait-caption-mark {
  display: grid;
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  color: var(--white);
  background: var(--teal);
  border-radius: 50%;
  place-items: center;
  font-size: 1.15rem;
  font-weight: 400;
}

.portrait-caption p {
  display: grid;
  gap: 0.08rem;
  margin: 0;
  font-size: 0.75rem;
  line-height: 1.35;
}

.portrait-caption strong {
  font-size: 0.84rem;
}

.portrait-caption span:not(.portrait-caption-mark) {
  color: var(--ink-soft);
}

.hero-card {
  position: absolute;
  top: 3.5rem;
  right: -4.2rem;
  display: flex;
  align-items: center;
  gap: 0.7rem;
  width: 188px;
  padding: 0.8rem;
  color: var(--ink-deep);
  background: var(--gold-pale);
  border-radius: var(--radius-sm);
  box-shadow: 0 10px 24px rgba(13, 44, 59, 0.1);
}

.hero-card-icon {
  display: grid;
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  color: var(--gold);
  place-items: center;
}

.hero-card-icon svg {
  width: 26px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.5;
}

.hero-card p {
  margin: 0;
  font-size: 0.72rem;
  line-height: 1.35;
}

.hero-card strong {
  display: block;
  font-size: 0.78rem;
}

.trust-bar {
  color: #e6f1ef;
  background: var(--ink-deep);
}

.trust-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  align-items: center;
  gap: clamp(0.8rem, 2vw, 2rem);
  min-height: 6.3rem;
}

.trust-grid p {
  margin: 0;
  font-size: 0.85rem;
  font-weight: 600;
  line-height: 1.5;
}

.trust-grid span {
  width: 4px;
  height: 4px;
  background: #8cc6bd;
  border-radius: 50%;
}

.section {
  padding: clamp(4.6rem, 8vw, 7.6rem) 0;
}

.section-intro {
  max-width: 700px;
}

.section-intro > p:last-child {
  max-width: 650px;
  margin-bottom: 0;
  font-size: 1.02rem;
}

.centered-intro {
  margin-inline: auto;
  text-align: center;
}

.centered-intro .eyebrow {
  justify-content: center;
}

.care-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: clamp(2.5rem, 4vw, 4rem);
}

.care-card {
  padding: clamp(1.5rem, 3vw, 2rem);
  background: var(--warm-white);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}

.care-card:hover {
  border-color: #afd0c9;
  box-shadow: 0 18px 36px rgba(13, 44, 59, 0.09);
  transform: translateY(-3px);
}

.care-icon {
  display: grid;
  width: 47px;
  height: 47px;
  margin-bottom: 1.4rem;
  border-radius: 12px;
  place-items: center;
}

.care-icon svg {
  width: 31px;
  height: 31px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.55;
}

.icon-navy {
  color: var(--ink-deep);
  background: #e5edf0;
}

.icon-teal {
  color: var(--teal-dark);
  background: var(--teal-pale);
}

.icon-gold {
  color: #a57831;
  background: var(--gold-pale);
}

.care-card h3 {
  margin-bottom: 0.55rem;
}

.care-card p {
  margin-bottom: 0;
  color: var(--ink-soft);
  font-size: 0.92rem;
}

.section-steps {
  background: var(--mist);
}

.steps-layout {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(3rem, 10vw, 9rem);
  align-items: start;
}

.steps-heading {
  position: sticky;
  top: 8rem;
}

.steps-heading > p {
  margin-bottom: 1.7rem;
}

.steps-list {
  margin: 0;
  padding: 0;
  list-style: none;
  border-top: 1px solid #c9d8d5;
}

.steps-list li {
  display: grid;
  grid-template-columns: 4.6rem 1fr;
  gap: 1rem;
  padding: 1.85rem 0;
  border-bottom: 1px solid #c9d8d5;
}

.steps-list > li > span {
  color: var(--gold);
  font-family: "DM Serif Display", Georgia, serif;
  font-size: 1.5rem;
  line-height: 1.2;
}

.steps-list h3 {
  margin-bottom: 0.4rem;
}

.steps-list p {
  margin: 0;
  color: var(--ink-soft);
  font-size: 0.94rem;
}

.physician-section {
  background: var(--cream);
}

.physician-layout {
  display: grid;
  grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1.18fr);
  gap: clamp(3rem, 9vw, 9rem);
  align-items: center;
}

.physician-photo-wrap {
  position: relative;
  width: min(100%, 425px);
  padding: 0 1.25rem 1.25rem 0;
}

.physician-photo {
  position: relative;
  z-index: 1;
  height: clamp(450px, 47vw, 560px);
  overflow: hidden;
  background: #d8d6d0;
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
}

.photo-accent {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 78%;
  height: 72%;
  background: var(--teal-pale);
  border-radius: var(--radius);
}

.physician-copy > p {
  max-width: 660px;
  margin-bottom: 0;
}

.credential-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.35rem 2rem;
  margin: 2rem 0 0;
}

.credential-list div {
  padding-top: 1rem;
  border-top: 1px solid var(--line);
}

.credential-list dt {
  margin-bottom: 0.3rem;
  color: var(--teal-dark);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.credential-list dd {
  margin: 0;
  color: var(--ink-soft);
  font-size: 0.85rem;
  line-height: 1.48;
}

.section-team {
  background: var(--warm-white);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.team-intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(250px, 0.64fr);
  gap: 2rem 5rem;
  align-items: end;
  max-width: none;
}

.team-intro h2 {
  margin-bottom: 0;
}

.team-intro > p {
  max-width: 410px;
  margin: 0 0 0.35rem;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-top: 3.1rem;
}

.team-member {
  display: grid;
  gap: 1.25rem;
  min-height: 270px;
  padding: 1.45rem;
  background: var(--cream);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}

.team-member-featured {
  color: #eef7f5;
  background: var(--ink-deep);
  border-color: var(--ink-deep);
}

.member-initials {
  display: grid;
  width: 42px;
  height: 42px;
  margin-bottom: 0;
  color: var(--teal-dark);
  background: var(--teal-pale);
  border-radius: 50%;
  place-items: center;
  font-size: 0.73rem;
  font-weight: 700;
}

.team-member-featured .member-initials {
  color: var(--ink-deep);
  background: #a6d5ce;
}

.team-member h3 {
  margin-bottom: 0.28rem;
  font-size: 1.02rem;
}

.team-member-featured h3 {
  color: var(--white);
}

.member-role {
  margin-bottom: 0.8rem;
  color: var(--teal-dark);
  font-size: 0.76rem;
  font-weight: 700;
  line-height: 1.4;
}

.team-member-featured .member-role {
  color: #9cd6cd;
}

.team-member > div > p:not(.member-role) {
  margin-bottom: 0;
  font-size: 0.83rem;
  line-height: 1.5;
}

.team-member-featured > div > p:not(.member-role) {
  color: #c8dad7;
}

.visit-section {
  background: var(--mist);
}

.visit-layout {
  display: grid;
  grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr);
  gap: clamp(3rem, 9vw, 9rem);
  align-items: center;
}

.location-photo {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1.3 / 1;
  background: #cbd8d5;
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
}

.location-photo::after {
  position: absolute;
  inset: auto 0 0;
  height: 34%;
  background: linear-gradient(transparent, rgba(13, 44, 59, 0.28));
  content: "";
}

.location-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.location-photo-label {
  position: absolute;
  bottom: 1.25rem;
  left: 1.25rem;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--white);
  font-size: 0.8rem;
  font-weight: 700;
}

.location-photo-label span {
  display: grid;
  width: 24px;
  height: 24px;
  color: var(--ink-deep);
  background: var(--white);
  border-radius: 50%;
  place-items: center;
}

.visit-copy > p {
  max-width: 580px;
  margin-bottom: 1.5rem;
}

.address-block {
  display: grid;
  gap: 0.05rem;
  margin-bottom: 1.6rem;
  color: var(--ink-soft);
  font-style: normal;
  font-size: 0.93rem;
  line-height: 1.55;
}

.address-block strong {
  color: var(--ink-deep);
}

.visit-details {
  display: grid;
  grid-template-columns: 0.85fr 1.2fr 0.95fr;
  gap: 0.8rem;
  margin-bottom: 1.7rem;
  padding-top: 1.35rem;
  border-top: 1px solid #c8d9d4;
}

.visit-details div {
  display: grid;
  gap: 0.2rem;
}

.visit-details span {
  color: var(--teal-dark);
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.visit-details p,
.visit-details a {
  margin: 0;
  color: var(--ink-deep);
  font-size: 0.86rem;
  font-weight: 600;
  line-height: 1.45;
  text-decoration: none;
}

.visit-details a:hover {
  color: var(--teal-dark);
  text-decoration: underline;
}

.appointment-section {
  padding: clamp(3rem, 5vw, 5rem) 0;
  color: #e5f0ee;
  background: var(--ink-deep);
}

.appointment-card {
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(260px, 0.65fr);
  gap: 2rem 5rem;
  align-items: center;
  padding: clamp(2rem, 5vw, 4rem);
  background:
    radial-gradient(circle at 92% 15%, rgba(148, 208, 197, 0.16), transparent 15rem),
    linear-gradient(112deg, #124656, #0c3545);
  border: 1px solid rgba(184, 221, 214, 0.16);
  border-radius: var(--radius-lg);
}

.eyebrow-light {
  color: #9bd4cb;
}

.appointment-card h2 {
  max-width: 620px;
  margin-bottom: 0.8rem;
  color: var(--white);
}

.appointment-card > div > p:not(.eyebrow) {
  max-width: 620px;
  margin-bottom: 0;
  color: #c5dad6;
}

.appointment-actions {
  justify-self: end;
  max-width: 300px;
}

.button-light {
  width: 100%;
  color: var(--ink-deep);
  background: var(--white);
}

.button-light:hover {
  background: #e8f3f1;
}

.appointment-actions p {
  margin: 0.9rem 0 0;
  color: #b8cfcb;
  font-size: 0.74rem;
  line-height: 1.45;
  text-align: center;
}

.site-footer {
  color: #c7dad7;
  background: #092633;
}

.footer-main {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.58fr);
  gap: 3rem;
  padding: clamp(3rem, 6vw, 5rem) 0;
}

.brand-footer {
  color: var(--white);
}

.footer-brand > p {
  max-width: 345px;
  margin: 1.3rem 0 0;
  color: #abc2be;
  font-size: 0.84rem;
}

.footer-links {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

.footer-links > div {
  display: grid;
  align-content: start;
  gap: 0.55rem;
}

.footer-label {
  margin-bottom: 0.35rem;
  color: #83b9b0;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer-links a {
  color: #d9e8e5;
  font-size: 0.82rem;
  line-height: 1.5;
  text-decoration: none;
}

.footer-links a:hover,
.footer-bottom a:hover {
  color: var(--white);
  text-decoration: underline;
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 4.7rem;
  border-top: 1px solid rgba(176, 210, 204, 0.15);
}

.footer-bottom p,
.footer-bottom a {
  margin: 0;
  color: #91aaa6;
  font-size: 0.72rem;
  text-decoration: none;
}

.footer-bottom a {
  color: #c8dad7;
  font-weight: 700;
}

@media (max-width: 1120px) {
  .site-nav {
    gap: 0.85rem;
  }

  .site-nav > a:not(.nav-cta) {
    font-size: 0.8rem;
  }

  .nav-cta {
    padding-inline: 0.75rem;
    font-size: 0.76rem;
  }

  .hero-card {
    right: -1.75rem;
  }

  .portrait-caption {
    left: -1.6rem;
  }

  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 930px) {
  .site-nav {
    position: absolute;
    top: calc(100% + 1px);
    right: -1.5rem;
    left: -1.5rem;
    display: none;
    align-items: stretch;
    gap: 0;
    padding: 0.75rem 1.5rem 1.25rem;
    background: var(--warm-white);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 18px 24px rgba(13, 44, 59, 0.09);
  }

  .site-nav.is-open {
    display: grid;
  }

  .site-nav > a:not(.nav-cta) {
    padding: 0.76rem 0;
    color: var(--ink-deep);
    border-bottom: 1px solid var(--line);
    font-size: 0.93rem;
  }

  .nav-cta {
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    font-size: 0.88rem;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .hero-layout,
  .steps-layout,
  .physician-layout,
  .visit-layout {
    grid-template-columns: 1fr;
  }

  .hero-layout {
    gap: 3.3rem;
  }

  .hero-portrait-wrap {
    justify-self: start;
    margin-left: clamp(0rem, 10vw, 5rem);
  }

  .hero-portrait-frame {
    height: min(120vw, 580px);
  }

  .steps-heading {
    position: static;
  }

  .physician-photo-wrap {
    width: min(100%, 480px);
  }

  .physician-photo {
    height: min(125vw, 570px);
  }

  .team-intro {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .team-intro > p {
    margin-top: 0.75rem;
  }

  .location-photo {
    width: min(100%, 620px);
  }

  .appointment-card {
    grid-template-columns: 1fr;
  }

  .appointment-actions {
    justify-self: start;
  }

  .footer-main {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 660px) {
  html {
    scroll-padding-top: 5.5rem;
  }

  .container {
    width: min(100% - 2rem, 1180px);
  }

  .utility-content {
    justify-content: center;
    min-height: 2.15rem;
  }

  .utility-content > p,
  .utility-links span,
  .utility-links a:last-child {
    display: none;
  }

  .header-content {
    min-height: 4.75rem;
  }

  .brand-mark {
    width: 37px;
    height: 37px;
  }

  .brand-name {
    font-size: 0.69rem;
  }

  .brand-name strong {
    font-size: 0.82rem;
  }

  .site-nav {
    right: -1rem;
    left: -1rem;
    padding-inline: 1rem;
  }

  .hero {
    padding-top: 3.8rem;
  }

  h1 {
    font-size: clamp(2.95rem, 13vw, 4.25rem);
  }

  h2 {
    font-size: clamp(2.2rem, 10vw, 3.25rem);
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
    gap: 1rem;
  }

  .button {
    width: 100%;
  }

  .text-link {
    justify-content: center;
  }

  .hero-highlights {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-portrait-wrap {
    width: calc(100% - 0.9rem);
    margin-left: 0;
    padding: 0.6rem;
  }

  .hero-portrait-frame {
    height: 121vw;
    max-height: 530px;
  }

  .portrait-caption {
    right: auto;
    bottom: -1.15rem;
    left: 1rem;
    max-width: calc(100% - 2rem);
  }

  .hero-card {
    top: auto;
    right: 0.4rem;
    bottom: 1.3rem;
  }

  .trust-grid {
    grid-template-columns: 1fr;
    gap: 0.55rem;
    padding: 1.5rem 0;
  }

  .trust-grid span {
    display: none;
  }

  .trust-grid p {
    font-size: 0.8rem;
  }

  .care-grid,
  .team-grid {
    grid-template-columns: 1fr;
  }

  .care-card {
    padding: 1.4rem;
  }

  .steps-list li {
    grid-template-columns: 3.3rem 1fr;
    gap: 0.65rem;
  }

  .credential-list {
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }

  .physician-photo-wrap {
    padding: 0 0.85rem 0.85rem 0;
  }

  .physician-photo {
    height: 121vw;
    max-height: 520px;
  }

  .team-member {
    min-height: auto;
  }

  .visit-details {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .appointment-card {
    padding: 1.75rem 1.35rem;
  }

  .appointment-actions {
    width: 100%;
  }

  .footer-main,
  .footer-links {
    grid-template-columns: 1fr;
  }

  .footer-main {
    gap: 2.5rem;
  }

  .footer-links {
    gap: 2rem;
  }

  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
